# Copy this file to .env and fill in values for your environment.
# .env is gitignored and never committed.

# Public URL of the backend API — baked into the Next.js bundle at build time.
# Local dev:  http://localhost:1234/api
# Server:     https://cc-vis.rz.uni-mannheim.de/api
PUBLIC_API_BASE=http://localhost:1234/api

# MongoDB credentials (must match between mongo and provibackend services).
MONGO_USERNAME=root
MONGO_PASSWORD=example

# Set to "prod" on the server to activate the nginx service with TLS.
# Leave blank for local development.
COMPOSE_PROFILES=
